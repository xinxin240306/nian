PORT=3000

# 站点访问锁（公网 HTTPS 部署建议开启；本地开发可设 0）
SITE_LOCK_ENABLED=1
SITE_LOCK_USER=your_username
SITE_LOCK_PASS=your_password
# 务必换成随机长字符串（不要用密码原文）
SITE_LOCK_SECRET=change-me-to-a-long-random-string

# 登录是否绑定 IP（默认不绑定：同一浏览器约 90 天内换网络也不用重输密码）
# 若希望换 IP 就必须重登，设为 1：
# SITE_LOCK_BIND_IP=1

# watchdog.sh 可选
# NIAN_HEALTH_URL=http://127.0.0.1:3000/api/health
# NIAN_PM2_NAME=nian
